{
  "name": "leo-learn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/content.mjs",
    "dev": "vite",
    "build": "npm run generate && tsc --noEmit && vite build",
    "check": "npm run generate && tsc --noEmit --pretty false",
    "test:search": "node --test scripts/search*.test.mjs",
    "test:bookmarks": "node --test scripts/bookmarks.test.mjs",
    "test:reading-memory": "node --test scripts/reading-memory.test.mjs",
    "test:layout": "node --test scripts/panel-widths.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mdx-js/rollup": "^3.1.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.25",
    "mermaid": "^12.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
